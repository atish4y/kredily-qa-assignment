		{
			"name": "4. Bug Verification Scenarios",
			"item": [
				{
					"name": "BUG-01: Live Track Meeting Plans (503 SCHEMA_PENDING)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Token {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mapi/v1/livetrack/my/plans/",
							"host": ["{{base_url}}"],
							"path": ["mapi", "v1", "livetrack", "my", "plans", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Expect Bug: Returns 503 SCHEMA_PENDING', function () {",
									"    pm.response.to.have.status(503);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error.code).to.eql('SCHEMA_PENDING');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
