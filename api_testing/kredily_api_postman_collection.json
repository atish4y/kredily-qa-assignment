{
	"info": {
		"_postman_id": "a91823b1-0981-4e78-9e62-c11fb0e2389a",
		"name": "Kredily HRMS Mobile API Suite",
		"description": "Comprehensive Postman API Test Collection for Kredily HRMS mobile endpoints. Covers positive, negative, and edge-case scenarios including authentication, dashboard metrics, leave balances, capabilities, and bug validations.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://app.upgrade.kredily.com"
		},
		{
			"key": "auth_token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "POST Login - Valid Credentials (Positive)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"peoplekredily1@yopmail.com\",\n  \"password\": \"Pass@9865\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ws/v1/accounts/set-password-login/",
							"host": ["{{base_url}}"],
							"path": ["ws", "v1", "accounts", "set-password-login", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response contains auth token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.environment.set('auth_token', jsonData.token);",
									"    pm.collectionVariables.set('auth_token', jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "POST Login - Invalid Password (Negative)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"peoplekredily1@yopmail.com\",\n  \"password\": \"WrongPass123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ws/v1/accounts/set-password-login/",
							"host": ["{{base_url}}"],
							"path": ["ws", "v1", "accounts", "set-password-login", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login fails for bad password', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401]);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
