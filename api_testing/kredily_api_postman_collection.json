							"host": ["{{base_url}}"],
							"path": ["ws", "v2", "company", "dashboard", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Returns HTTP 401 Unauthorized', function () {",
